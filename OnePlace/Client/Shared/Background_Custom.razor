@inject IRepositorio http
@inject IMostrarMensaje message

<div class="container-xxl position-relative p-0">
    @if (Fragment is null)
    {
        <nav class="navbar navbar-expand-lg navbar-light px-4 px-lg-5 py-5 py-lg-0">
            <a href="inicio" class="navbar-brand p-0">
                <!--<h1 class="m-0"><i class="fa fa-search me-2"></i>SEO<span class="fs-5">Master</span></h1> -->
                <img src="img/oneplace.png" alt="Logo">
            </a>
            <button class="navbar-toggler" type="button">
                <span class="fa fa-bars"></span>
            </button>
            <div class="navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ml-auto py-0">
                    <a href="inicio" class="nav-item nav-link">Inicio</a>
                    <a onclick="document.getElementById('promociones').scrollIntoView({ behavior: 'smooth' })" class="nav-item nav-link">Promociones</a>
                    <a onclick="document.getElementById('cursos').scrollIntoView({ behavior: 'smooth' })" class="nav-item nav-link">Cursos</a>
                    <a href="capacitacioninfoextra" class="nav-item nav-link">Capacitación</a>
                    <a onclick="document.getElementById('contacto').scrollIntoView({ behavior: 'smooth' })" class="nav-item nav-link">Contacto</a>
                </div>
            </div>
            <EnlacesLogin ColorDropDown="btn btn-simsasecondary btn-sm ml-2 dropdown-caret-none" />
        </nav>
    }
    else
    {
        @Fragment
    }


    <div class="container-xxl py-5 bg-simsa hero-header mb-5" id="inicio" style="@(!string.IsNullOrEmpty(Color_Hex) ? $"background-color:{Color_Hex};" : null)">

        <div class="container my-5 py-5 px-lg-5">


            @if (ShowContent)
            {
                <div class="row g-5 py-5">
                    <div class="col-lg-6 text-center text-lg-start">
                        <div>
                            <img class="img-fluid animated flipInX" src="@Imagen_Logo" alt="">

                        </div>
                        <div>
                            <p class="text-white pb-1 animated zoomIn">@Texto_Portada</p>
                        </div>
                    </div>
                    <div class="col-lg-6 text-center text-lg-start">
                        <img class="img-fluid animated flipInX" src="@Imagen_Portada" />
                    </div>
                </div>
            }
            else
            {
                @if (FragmentContent is not null)
                {
                    @FragmentContent
                }
                else
                {
                    <div class="py-3"></div>

                }
            }


        </div>

    </div>

</div>

@code {
    private string Color_Hex = string.Empty;
    private string Texto_Portada = string.Empty;
    private string Imagen_Portada = string.Empty;
    private string Imagen_Logo = string.Empty;

    [Parameter] public bool ShowContent { get; set; } = true;
    [Parameter] public RenderFragment Fragment { get; set; }
    [Parameter] public RenderFragment FragmentContent { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await Obtener_Color();
        await Obtener_Texto_Portada();
        await Obtener_Imagen_Logo();
        await Obtener_Imagen_Portada();
    }

    private async Task Obtener_Color()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/fondo/color/header");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Color_Hex = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

    private async Task Obtener_Texto_Portada()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/texto/portada");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Texto_Portada = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

    private async Task Obtener_Imagen_Portada()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/imagen/portada");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Imagen_Portada = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

    private async Task Obtener_Imagen_Logo()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/imagen/logo");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Imagen_Logo = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

}