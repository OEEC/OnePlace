@code {
    private string Color_Hex = string.Empty;
    private string Texto_Portada = string.Empty;
    private string Imagen_Portada = string.Empty;
    private string Imagen_Logo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Obtener_Color();
        await Obtener_Texto_Portada();
        await Obtener_Imagen_Logo();
        await Obtener_Imagen_Portada();
    }

    private async Task Obtener_Color()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/fondo/color/header");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Color_Hex = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

    private async Task Obtener_Texto_Portada()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/texto/portada");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Texto_Portada = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

    private async Task Obtener_Imagen_Portada()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/imagen/portada");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Imagen_Portada = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

    private async Task Obtener_Imagen_Logo()
    {
        try
        {
            var response = await http.Get<Configuracion>("api/configuracion/imagen/logo");
            if (response.Error)
            {
                var er_message = await response.GetBody();
                await message.MostrarMensajeError(er_message);
            }
            else
            {
                Imagen_Logo = response.Response.Valor;
            }
        }
        catch (Exception e)
        {
            await message.MostrarMensajeError(e.Message);
        }
    }

}