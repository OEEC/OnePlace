<div class="card mb-3">
    <div class="card-body">
        <p class="card-text"><b>@Question.Pregunta</b></p>
        <div>

            @foreach (var respuesta in Question.TipoRespuestas)
            {
                if (respuesta.TipoPreguntaId == 1)
                {
                    // Obtener la respuesta del usuario si existe, por ejemplo "4"
                    var userAnswer = Question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                    @if (userAnswer == null)
                    {
                        <p class="text-warning mt-2">Sin respuesta aún.</p>
                    }
                    else
                    {
                        <p class="text-success mt-2">Ultima Respuesta: <strong>@userAnswer</strong></p>
                    }

                    // Generar radios desde 1 hasta 'respuesta.Cantidad'
                    for (int i = 1; i <= respuesta.Cantidad; i++)
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input"
                                   type="radio"
                                   name="@($"respuesta-{Question.Idpregunta}")"
                                   id="@($"respuesta-{Question.Idpregunta}-{i}")"
                                   value="@i"
                                   @onchange="(e) => AnswerChanged(e.Value.ToString())"
                                   />
                            <label class="form-check-label" for="@($"respuesta-{Question.Idpregunta}-{i}")">
                                @(respuesta?.Texto ?? i.ToString())
                            </label>
                        </div>
                    }
                }
                else if (respuesta.TipoPreguntaId == 2)
                {
                    var inputRespuesta = Question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
@*                    <div class="form-group">
                        <input type="text"
                               class="form-control"
                               id="@($"respuesta-text-{Question.Idpregunta}")"
                               value="@inputRespuesta"
                               placeholder="Escribe tu respuesta aquí..."
                               @onchange="(e) => AnswerChanged(e.Value.ToString())" />
                    </div>*@

                    <div class="form-group">
                        <select class="form-select" aria-label="seleccionar encargaado"
                                @onchange="(e) => AnswerChanged(e.Value.ToString())">
                            <option selected disabled>Selecciona a la persona</option>
                            @foreach (var encargado in ListaEncargados)
                            {
                                <option value="@encargado.Idempleado">@encargado.Persona.FullName</option>
                            }
                        </select>
                    </div>
                }

            }
        </div>
    </div>
</div>

@code {
    [Parameter] public QPreguntaConRespuestasDTO Question { get; set; }
    [Parameter] public EventCallback<(int questionId, string answer)> OnSelectAnswer { get; set; }
    [Parameter] public List<Empleado> ListaEncargados { get; set; }

    private async Task AnswerChanged(string answer)
    {
        await OnSelectAnswer.InvokeAsync((Question.Idpregunta, answer));
    }

    private bool IsChecked(string userResponse, int value)
    {
        // Devuelve true si la respuesta del usuario coincide con el valor actual 'value'.
        return !string.IsNullOrEmpty(userResponse) && Convert.ToInt32(userResponse) == value;
    }
}
