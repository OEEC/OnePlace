@inject HttpClient HttpClient
<style>
    .navbar {
        /*background-color: #e63946; /* Rojo */
        background: rgb(255,255,255);
        background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(242,227,0,0.4150035014005602) 100%);
    }

    .navbar-brand img {
        height: 50px;
    }

    .btn-iniciar {
        background-color: #f1c40f; /* Amarillo */
        color: #000; /* Texto negro */
    }

        .btn-iniciar:hover {
            background-color: #d4ac0d; /* Amarillo oscuro */
        }

    .card {
        border: none;
        background-color: #f8f9fa; /* Fondo claro */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }
</style>
<!-- Barra de Navegación -->
<nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">
            <img src="img/quiz.png" class="img-fluid">
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <span><b>@area.AreaTrabajo </b></span>
                    <span><b>@area.Division</b></span>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    private QNavbarDTO area = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadArea();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inicializando: {ex.Message}");
        }
    }

    private async Task LoadArea()
    {
        try
        {
            var response = await HttpClient.GetFromJsonAsync<QNavbarDTO>("api/grupo/departamento");
            area = response;
            Console.WriteLine($"estacion: {response}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar departamento: {ex.Message}");
        }
    }
}
