@page "/qpreguntas"
@inject HttpClient HttpClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IMostrarMensaje mensaje
@inject NavigationManager navigationManager
@inject IJSRuntime JS
@using System.Security.Claims
@using OnePlace.Shared.DTOs;

<QNavBar />
<h1 class="text-center my-4">Cuestionario</h1>

<!-- Barra de grupos -->
<div class="d-flex justify-content-center mb-4">
    @if (Groups.Any())
    {
        @foreach (var group in Groups)
        {
            <button class="btn me-2 @GetGroupClass(group)"
            @onclick="() => ChangeGroup(group)"
                    disabled="@IsGroupDisabled(group)">
                @switch (group.Idgrupo)
                {
                    case 1:
                        <i class="fa-solid fa-users-viewfinder ml-1"></i> @group.Grupo
                        break;
                    case 2:
                        <i class="fa-solid fa-ear-listen"></i> @group.Grupo
                        break;
                    case 3:
                        <i class="fa-regular fa-lightbulb"></i> @group.Grupo
                        break;
                    case 4:
                        <i class="fa-solid fa-arrow-trend-up"></i> @group.Grupo
                        break;
                    case 5:
                        <i class="fa-solid fa-users-rays"></i> @group.Grupo
                        break;
                    case 6:
                        <i class="fa-solid fa-hand-holding-heart"></i> @group.Grupo
                        break;
                    case 7:
                        <i class="bi bi-cone-striped"></i> @group.Grupo
                        break;
                    case 8:
                        <i class="fa-solid fa-bullhorn"></i> @group.Grupo
                        break;
                }
            </button>
        }
    }
    else
    {
        <p>Cargando grupos...</p>
    }
</div>

<!-- Iniciar el formulario -->
<form @ref="formElement" onsubmit="return false;">
    <div class="container">
        @if (string.IsNullOrEmpty(CurrentGroup.Grupo))
        {
            <div class="alert alert-info" role="alert">
                Selecciona un grupo para comenzar.
            </div>
        }
        else
        {
            <h2 class="text-primary">@CurrentGroup.Grupo</h2>
            <div class="mt-3">
                @if (Questions.Any())
                {
                    @foreach (var question in Questions)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <p class="card-text"><b>@question.Pregunta</b></p>
                                <div>
                                    @foreach (var respuesta in question.TipoRespuestas)
                                    {
                                        @if (respuesta.TipoPreguntaId == 1)
                                        {
                                            var RespuestaCheck = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                            @for (int i = 1; i <= respuesta.Cantidad; i++)
                                            {
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="@($"respuesta-radio-{question.Idpregunta}")"
                                                           id="@($"respuesta-radio-{question.Idpregunta}-{i}")"
                                                           value="@i"
                                   @onchange="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())"
                                                        />
                                                    <label class="form-check-label" for="@($"respuesta-{question.Idpregunta}-{i}")">
                                                        @(respuesta?.Texto ?? i.ToString())
                                                    </label>
                                                </div>
                                            }
                                        }

                                        @if (respuesta.TipoPreguntaId == 2)
                                        {
                                            var inputRespuesta = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                            <div class="form-group">
                                                <input type="text"
                                                       class="form-control"
                                                       name="@($"respuesta-text-{question.Idpregunta}")"
                                                       id="@($"respuesta-text-{question.Idpregunta}")"
                                                       value="@inputRespuesta"
                                                       placeholder="Escribe tu respuesta aquí..."
                                   @oninput="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())" />
                                            </div>
                                        }

                                        @if (respuesta.TipoPreguntaId == 3)
                                        {
                                            var texttoRespuesta = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                            <div class="form-group">
                                                <textarea class="form-control"
                                                          name="@($"respuesta-txtarea-{question.Idpregunta}")"
                                                          id="@($"respuesta-txtarea-{question.Idpregunta}")"
                                                          placeholder="Escribe tu respuesta aquí..."
                                      @oninput="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())"
                                                          rows="3">@texttoRespuesta</textarea>
                                            </div>
                                        }

                                        var selectedAnswer = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                        @if (selectedAnswer == null)
                                        {
                                            <p class="text-warning mt-2">Sin respuesta aún.</p>
                                        }
                                        else
                                        {
                                            <p class="text-success mt-2">Ultima Respuesta: <strong>@selectedAnswer</strong></p>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        No hay preguntas en este grupo.
                    </div>
                }

                <!-- Navegación entre grupos -->
                <div class="d-flex justify-content-between mt-4 mb-4">
                    <button class="btn btn-warning btn-lg" @onclick="LoadPreviousGroup" disabled="@IsFirstGroup()">Anterior</button>
                    <button class="btn btn-warning btn-lg" type="button"
                        @onclick="SaveAndLoadNextGroup"
                            disabled="@(!ListaRespuestas.Any() && !HasUserResponses())">
                        @(IsLastGroup() ? "Finalizar" : "Siguiente")
                    </button>
                </div>
            </div>
        }
    </div>
</form>

@code {
    private List<QGrupo> Groups = new();
    private QGrupo CurrentGroup = new();
    private List<QPreguntaConRespuestasDTO> Questions = new();
    private List<QRespuestaDTO> ListaRespuestas = new();
    private Dictionary<int, string> Answers = new();
    private ElementReference formElement;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Cargar los grupos
            await LoadGroupsAsync();
            if (Groups.Any())
            {
                await ChangeGroup(Groups.First());
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inicializando: {ex.Message}");
        }
    }

    private async Task LoadGroupsAsync()
    {
        try
        {
            var response = await HttpClient.GetFromJsonAsync<List<QGrupo>>("api/grupo/grupos");
            if (response != null) Groups = response;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar grupos: {ex.Message}");
        }
    }

    private async Task ChangeGroup(QGrupo group)
    {
        try
        {
            CurrentGroup = group;
            ListaRespuestas.Clear();
            await LoadQuestionsAsync(group.Idgrupo);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cambiando grupo: {ex.Message}");
        }
    }

    private async Task LoadQuestionsAsync(int groupId)
    {
        try
        {
            var response = await HttpClient.GetFromJsonAsync<List<QPreguntaConRespuestasDTO>>($"api/pregunta/preguntas/{groupId}");
            Questions.Clear();
            if (response != null) Questions = response;
        }
        catch (Exception ex)
        {
            await mensaje.MostrarMensajeError($"Error cargando preguntas: {ex.Message}");
            Console.WriteLine($"Error cargando preguntas: {ex.Message}");
        }
    }

    private bool IsGroupDisabled(QGrupo group) => group.Idgrupo != CurrentGroup.Idgrupo;

    private void SelectAnswer(int questionId, string answer)
    {
        var existingAnswer = ListaRespuestas.FirstOrDefault(r => r.PreguntaId == questionId);
        if (existingAnswer != null)
        {
            existingAnswer.Respuesta = answer;
            existingAnswer.Fecha = DateTime.Now;
        }
        else
        {
            ListaRespuestas.Add(new QRespuestaDTO
                {
                    PreguntaId = questionId,
                    Respuesta = answer,
                    Fecha = DateTime.Now
                });
        }
    }

    private async Task SaveAndLoadNextGroup()
    {
        // Aquí obtienes los datos del formulario vía JS:
        string jsonData = await JS.InvokeAsync<string>("myFunctions.getFormData", formElement);

        // Deserializar a diccionario
        var formValues = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, string>>(jsonData);

        // Reconstruir la lista de respuestas desde el formulario
        ListaRespuestas.Clear();
        foreach (var kvp in formValues)
        {
            Console.WriteLine($"key: {kvp}");
            if (kvp.Key.StartsWith("respuesta-radio"))
            {
                var parts = kvp.Key.Split('-');
                // parts[1] sería el Id de la pregunta
                if (parts.Length >= 2 && int.TryParse(parts[1], out int questionId))
                {
                    ListaRespuestas.Add(new QRespuestaDTO
                        {
                            PreguntaId = questionId,
                            Respuesta = kvp.Value,
                            Fecha = DateTime.Now
                        });
                }
            }
            else if (kvp.Key.StartsWith("respuesta-text"))
            {
                var parts = kvp.Key.Split('-');
                // parts[1] sería el Id de la pregunta
                if (parts.Length >= 2 && int.TryParse(parts[1], out int questionId))
                {
                    ListaRespuestas.Add(new QRespuestaDTO
                        {
                            PreguntaId = questionId,
                            Respuesta = kvp.Value,
                            Fecha = DateTime.Now
                        });
                }
            }
            else if (kvp.Key.StartsWith("respuesta-txtarea"))
            {
                var parts = kvp.Key.Split('-');
                // parts[1] sería el Id de la pregunta
                if (parts.Length >= 2 && int.TryParse(parts[1], out int questionId))
                {
                    ListaRespuestas.Add(new QRespuestaDTO
                        {
                            PreguntaId = questionId,
                            Respuesta = kvp.Value,
                            Fecha = DateTime.Now
                        });
                }
            }
        }

        // Verifica que haya respuestas
        if (!ListaRespuestas.Any() && !HasUserResponses())
        {
            await mensaje.MostrarMensajeError("Por favor, responde al menos una pregunta antes de continuar.");
            return;
        }

        if (!await SaveAnswersAsync())
        {
            return; // Si no se guardan, no avanzar
        }

        var currentIndex = Groups.IndexOf(CurrentGroup);
        if (currentIndex < Groups.Count - 1)
        {
            await ChangeGroup(Groups[currentIndex + 1]);
        }
        else
        {
            navigationManager.NavigateTo("/finalizar");
        }
    }

    private string GetGroupClass(QGrupo group) => group.Idgrupo == CurrentGroup.Idgrupo ? "btn-warning" : "btn-outline-danger";

    private async Task LoadPreviousGroup()
    {
        var currentIndex = Groups.IndexOf(CurrentGroup);
        if (currentIndex > 0)
        {
            await ChangeGroup(Groups[currentIndex - 1]);
        }
    }

    private bool IsFirstGroup() => Groups.IndexOf(CurrentGroup) == 0;
    private bool IsLastGroup() => Groups.IndexOf(CurrentGroup) == Groups.Count - 1;

    private bool HasUserResponses()
    {
        return Questions.Any(q => q.RespuestaUsuario != null && q.RespuestaUsuario.Any());
    }

    private async Task<bool> SaveAnswersAsync()
    {
        try
        {
            if (!ListaRespuestas.Any() && !HasUserResponses())
            {
                await mensaje.MostrarMensajeError("Por favor, responde las preguntas antes de continuar.");
                return false;
            }

            if (ListaRespuestas.Any() && Questions.Count > ListaRespuestas.Count && !HasUserResponses())
            {
                await mensaje.MostrarMensajeError("Hay preguntas sin respuesta.");
                return false;
            }

            var response = await HttpClient.PostAsJsonAsync("api/qrespuesta/guardar", ListaRespuestas);
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Respuestas guardadas exitosamente.");
                ListaRespuestas.Clear();
                return true;
            }
            else
            {
                await mensaje.MostrarMensajeError($"Error al guardar respuestas: {response.ReasonPhrase}");
                return false;
            }
        }
        catch (Exception ex)
        {
            await mensaje.MostrarMensajeError($"Error al guardar respuestas: {ex.Message}");
            return false;
        }
    }
}
