@page "/preguntas"
@inject HttpClient HttpClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IMostrarMensaje mensaje
@using System.Security.Claims
@using OnePlace.Shared.DTOs;

<QNavBar />
<h1 class="text-center my-4">Cuestionario</h1>

<!-- Barra de grupos -->
<div class="d-flex justify-content-center mb-4">
    @if (Groups.Any())
    {
        @foreach (var group in Groups)
        {
            <button class="btn me-2 @GetGroupClass(group)" @onclick="() => ChangeGroup(group)">
                @group.Grupo
            </button>
        }
    }
    else
    {
        <p>Cargando grupos...</p>
    }
</div>

<!-- Contenido del grupo -->
<div class="container">
    @if (string.IsNullOrEmpty(CurrentGroup.Grupo))
    {
        <div class="alert alert-info" role="alert">
            Selecciona un grupo para comenzar.
        </div>
    }
    else
    {
        <h2 class="text-primary">@CurrentGroup.Grupo</h2>
        <div class="mt-3">
            @if (Questions.Any())
            {
               @foreach (var question in Questions)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <p class="card-text">@question.Pregunta</p>
                            <div>
                                @foreach (var respuesta in question.TipoRespuestas)
                                {
                                    <!-- Verificar si existe una respuesta del usuario -->
                                    @if (respuesta.TipoPreguntaId == 1)
                                    {
                                        var RespuestaCheck = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                        <!-- Generar los botones de radio -->
                                        @for (int i = 1; i <= respuesta.Cantidad; i++)
                                        {
                                            @if (Convert.ToInt32(RespuestaCheck) == i && RespuestaCheck != null)
                                            {
                                             <div class="form-check form-check-inline">
                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="@($"respuesta-{question.Idpregunta}")"
                                                       id="@($"respuesta-{question.Idpregunta}-{i}")"
                                                       value="@i"
                                                     @onchange="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())"
                                                       checked="true" />
                                                <label class="form-check-label" for="@($"respuesta-{question.Idpregunta}-{i}")">
                                                    @(respuesta?.Texto ?? i.ToString())
                                                </label>
                                            </div>
                                            }
                                            else
                                            {
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input"
                                                           type="radio"
                                                           name="@($"respuesta-{question.Idpregunta}")"
                                                           id="@($"respuesta-{question.Idpregunta}-{i}")"
                                                           value="@i"
                                                            @onchange="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())" />
                                                    <label class="form-check-label" for="@($"respuesta-{question.Idpregunta}-{i}")">
                                                        @(respuesta?.Texto ?? i.ToString())
                                                    </label>
                                                </div>
                                            }
@*                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="@($"respuesta-{question.Idpregunta}")"
                                                       id="@($"respuesta-{question.Idpregunta}-{i}")"
                                                       value="@i"
                                                     @onchange="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())"
                                                       checked="@(RespuestaCheck != null && RespuestaCheck == i.ToString())" />
                                                <label class="form-check-label" for="@($"respuesta-{question.Idpregunta}-{i}")">
                                                    @(respuesta?.Texto ?? i.ToString())
                                                </label>
                                            </div>*@
                                        }
                                    }
                                    @if (respuesta.TipoPreguntaId == 2)
                                    {
                                        var inputRespuesta = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                        <div class="form-group">
                                            @*                  <label for="@($"respuesta-text-{question.Idpregunta}")" class="form-label">Respuesta:</label>*@
                                            <input type="text"
                                                   class="form-control"
                                                   id="@($"respuesta-text-{question.Idpregunta}")"
                                                   value="@inputRespuesta"
                                                   placeholder="Escribe tu respuesta aquí..."
                                                    @oninput="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())" />
                                        </div>
                                    }
                                    @if (respuesta.TipoPreguntaId == 3)
                                    {
                                        var texttoRespuesta = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                        <div class="form-group">
                                           @* <label for="exampleFormControlTextarea1">Example textarea</label>*@
                                            <textarea class="form-control" 
                                            id="@($"respuesta-text-{question.Idpregunta}")"
                                                      value="@texttoRespuesta"
                                            placeholder="Escribe tu respuesta aquí..."
                                            @oninput="(e) => SelectAnswer(question.Idpregunta, e.Value.ToString())"
                                            rows="3"></textarea>
                                        </div>
                                    }
                                    var selectedAnswer = question.RespuestaUsuario?.FirstOrDefault()?.Respuesta;
                                    <!-- Mostrar mensaje si no hay respuesta seleccionada -->
                                    @if (selectedAnswer == null)
                                    {
                                        <p class="text-warning mt-2">Sin respuesta aún.</p>
                                    }
                                    else
                                    {
                                        <p class="text-success mt-2">Ultima Respuesta: <strong>@selectedAnswer</strong></p>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    No hay preguntas en este grupo.
                </div>
            }

            <!-- Navegación entre grupos -->
            <div class="d-flex justify-content-between mt-4 mb-4">
                <button class="btn btn-warning btn-lg" @onclick="LoadPreviousGroup" disabled="@IsFirstGroup()">Anterior</button>
                <button class="btn btn-warning btn-lg" @onclick="SaveAndLoadNextGroup" disabled="@IsLastGroup()">Siguiente</button>
               @* <button class="btn btn-warning btn-lg" @onclick="SaveAndLoadNextGroup" disabled="@IsLastGroup()">Finalizar</button>*@
@*                <button class="btn btn-warning btn-lg" @onclick="LoadPreviousGroup" disabled="@IsFirstGroup()">Anterior</button>
                <button class="btn btn-warning btn-lg" @onclick="SaveAndLoadNextGroup" disabled="@IsLastGroup()">Siguiente</button>*@
            </div>
        </div>
    }
</div>

@code {
    private List<QGrupo> Groups = new();
    private QGrupo CurrentGroup = new();
    private List<QPreguntaConRespuestasDTO> Questions = new();
    private List<QRespuestaDTO> ListaRespuestas = new();
    private List<int> Options = new() { 1, 2, 3, 4, 5 };
    private Dictionary<int, string> Answers = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            //Funcion para cargar los grupos
            await LoadGroupsAsync();
            //Si no hay nungun grupo, seleccionado carga el primero
            if (Groups.Any())
            {
                await ChangeGroup(Groups.First());
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error inicializando: {ex.Message}");
        }
    }
    //Trae todos los grupos
    private async Task LoadGroupsAsync()
    {
        try
        {
            var response = await HttpClient.GetFromJsonAsync<List<QGrupo>>("api/grupo/grupos");
            if (response != null) Groups = response;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar grupos: {ex.Message}");
        }
    }
    //Cambia el grupo y trae las preguntas del grrupo seleccionado
    private async Task ChangeGroup(QGrupo group)
    {
        try
        {
            if (group.Idgrupo == 1)
            {
                CurrentGroup = group;
                await LoadQuestionsAsync(group.Idgrupo);
            } else
            {
                if (ListaRespuestas.Any()) // Asegurarte de que se guarden las respuestas
                {
                    CurrentGroup = group;
                    await LoadQuestionsAsync(group.Idgrupo);
                }
                else
                {
                    await mensaje.MostrarMensajeError("No hay respuestas para guardar.");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cambiando grupo: {ex.Message}");
        }
    }
    //Trae las preguntas con las respuestas de acuerdo al grupo seleccionado
    private async Task LoadQuestionsAsync(int groupId)
    {
        try
        {
            var response = await HttpClient.GetFromJsonAsync<List<QPreguntaConRespuestasDTO>>($"api/pregunta/preguntas/{groupId}");
            if (response != null) Questions = response;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando preguntas: {ex.Message}");
        }
    }
    //Guarda el valor de la respuesta en un arreglo
    private void SelectAnswer(int questionId, string answer)
    {
        Answers[questionId] = answer;
        // Busca si ya existe una respuesta para esta pregunta
        var respuestaExistente = ListaRespuestas.FirstOrDefault(r => r.PreguntaId == questionId);

        if (respuestaExistente != null)
        {
            // Actualiza la respuesta si ya existe
            respuestaExistente.Respuesta = answer;
            respuestaExistente.Fecha = DateTime.Now;
        }
        else
        {
            // Agrega una nueva respuesta si no existe
            ListaRespuestas.Add(new QRespuestaDTO
                {
                    PreguntaId = questionId,
                    Respuesta = answer,
                    Fecha = DateTime.Now
                });
        }

        Console.WriteLine($"Pregunta: {questionId}, Respuesta: {answer}");
        Console.WriteLine(answer);
    }
    //Guarda las respuestas y cambia al siguiente grupo
    private async Task SaveAndLoadNextGroup()
    {
        // Guardar las respuestas
        await SaveAnswersAsync();
        if (ListaRespuestas.Any()) // Asegurarte de que se guarden las respuestas
        {
            var currentIndex = Groups.IndexOf(CurrentGroup);
            if (currentIndex < Groups.Count - 1)
            {
                await ChangeGroup(Groups[currentIndex + 1]);
            }
        }
        else
        {
            Console.WriteLine("Error al guardar respuestas. No se avanzará al siguiente grupo.");
        }
    }
    //Cambai el estilo de los botones de los grupos
    private string GetGroupClass(QGrupo group)
    {
        return group.Idgrupo == CurrentGroup.Idgrupo ? "btn-warning" : "btn-outline-danger";
    }
    //CArga el grupo anterior
    private async Task LoadPreviousGroup()
    {
        var currentIndex = Groups.IndexOf(CurrentGroup);
        if (currentIndex > 0)
        {
            await ChangeGroup(Groups[currentIndex - 1]);
        }
    }

    //Si es el primer grupo desactiva el boton para ir al grupo anterior
    private bool IsFirstGroup() => Groups.IndexOf(CurrentGroup) == 0;
    //Si es el ultimo grupo desactia el boton para ir al siguiente grupo
    private bool IsLastGroup() => Groups.IndexOf(CurrentGroup) == Groups.Count - 1;

    private async Task SaveAnswersAsync()
    {
        try
        {
            if (!ListaRespuestas.Any())
            {
                await mensaje.MostrarMensajeError("No hay respuestas para guardar.");
                Console.WriteLine("No hay respuestas para guardar.");
                return;
            }
            var response = await HttpClient.PostAsJsonAsync("api/qrespuesta/guardar", ListaRespuestas);
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Respuestas guardadas exitosamente.");
                ListaRespuestas.Clear(); // Limpiar la lista después de guardar
            }
            else
            {
                Console.WriteLine($"Error al guardar respuestas: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar respuestas: {ex.Message}");
        }
    }
}
